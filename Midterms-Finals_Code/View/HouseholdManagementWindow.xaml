<Window x:Class="AquaTrack.View.HouseholdManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AquaTrack.View"
        Title="AquaTrack — Household Management"
        Height="620" Width="1080"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/> <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>        <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>             <Setter Property="RowBackground" Value="#060F25"/>
            <Setter Property="AlternatingRowBackground" Value="#0A1628"/>
            <Setter Property="GridLinesVisibility" Value="None"/> <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>     <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0D1F3C"/> <Setter Property="Foreground" Value="#7DD3FC"/>
                        <Setter Property="FontWeight" Value="SemiBold"/> <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Inp" TargetType="Border">
            <Setter Property="Background" Value="#06172B"/> <Setter Property="BorderBrush" Value="#1E3A5F"/>
            <Setter Property="BorderThickness" Value="1"/>  <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Resources>
    <Viewbox>
        <Grid Width="800">
            <Grid.Background><ImageBrush ImageSource="../Images/WaterHomepageBG.png"/></Grid.Background>
            <local:AdminNavBarControl DataContext="{Binding NavBar}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>

            <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="110,0,0,0" Width="640">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Form -->
                <Border Grid.Row="0" Background="#050F2D" BorderBrush="#1E5EFF"
                        BorderThickness="1" CornerRadius="14" Padding="20,14">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#0A84FF" Opacity="0.3"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Register Household" FontFamily="Segoe UI" FontSize="14"
                                   FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="HOUSEHOLD ID" FontSize="9" Foreground="#4A7FA5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <Border Style="{StaticResource Inp}">
                                    <TextBox Text="{Binding HouseholdID, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" Foreground="White" BorderThickness="0"
                                             FontFamily="Segoe UI" Height="34" Padding="10,0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0">
                                <TextBlock Text="ACCOUNT NUMBER" FontSize="9" Foreground="#4A7FA5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <Border Style="{StaticResource Inp}">
                                    <ComboBox ItemsSource="{Binding UnlinkedAccounts}"
                                              SelectedItem="{Binding AccNum}"
                                              Background="Transparent" Foreground="White" BorderThickness="0"
                                              FontFamily="Segoe UI" Height="34"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="OWNER NAME" FontSize="9" Foreground="#4A7FA5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <Border Style="{StaticResource Inp}">
                                    <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" Foreground="White" BorderThickness="0"
                                             FontFamily="Segoe UI" Height="34" Padding="10,0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="EMAIL" FontSize="9" Foreground="#4A7FA5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <Border Style="{StaticResource Inp}">
                                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                                 FontFamily="Segoe UI" Height="34" Padding="10,0" VerticalContentAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0">
                                    <TextBlock Text="ADDRESS" FontSize="9" Foreground="#4A7FA5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <Border Style="{StaticResource Inp}">
                                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                                 FontFamily="Segoe UI" Height="34" Padding="10,0" VerticalContentAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                                <Button Content="Register" Command="{Binding RegisterCommand}"
                                        Width="90" Height="34" Cursor="Hand" Foreground="White" Margin="0,0,6,0">
                                    <Button.Template><ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="8" Background="#0EA5E9">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate></Button.Template>
                                </Button>
                                <Button Content="🚫 Disable" Command="{Binding DisableCommand}"
                                        Width="90" Height="34" Cursor="Hand" Foreground="White">
                                    <Button.Template><ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="8" Background="#7F1D1D">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate></Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Message}" FontFamily="Segoe UI" FontSize="11" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#F87171"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="#4ADE80"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- DataGrid -->
                <Border Grid.Row="2" Background="#050F2D" BorderBrush="#1E5EFF"
                        BorderThickness="1" CornerRadius="14">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#0A84FF" Opacity="0.3"/></Border.Effect>
                    <DataGrid ItemsSource="{Binding Households}"
                              SelectedItem="{Binding SelectedHousehold, Mode=TwoWay}"
                              Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Household ID"   Binding="{Binding HouseholdID}"      Width="100"/>
                            <DataGridTextColumn Header="Account"        Binding="{Binding AccountNumber}"    Width="100"/>
                            <DataGridTextColumn Header="Owner"          Binding="{Binding OwnerName}"        Width="140"/>
                            <DataGridTextColumn Header="Email"          Binding="{Binding Email}"            Width="150"/>
                            <DataGridTemplateColumn Header="Status"     Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#4ADE80"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="#F87171"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Window>