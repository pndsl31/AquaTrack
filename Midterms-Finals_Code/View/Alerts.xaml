<Window x:Class="AquaTrack.View.Alerts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaTrack — Alerts"
        Background="#020B2E"
        Height="620" Width="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Viewbox>
        <Grid Width="894">
            <Grid.Background>
                <ImageBrush ImageSource="../Images/WaterHomepageBG.png"/>
            </Grid.Background>

            <!-- ===== NAV BAR ===== -->
            <Expander HorizontalAlignment="Left" Height="506" Header="☰  AquaTrack"
                      IsExpanded="False" VerticalAlignment="Bottom"
                      Foreground="White" Panel.ZIndex="10">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontFamily"      Value="Segoe UI"/>
                        <Setter Property="FontSize"        Value="13"/>
                        <Style.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter Property="Width" Value="32"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter Property="Width" Value="200"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Grid Margin="0,4,0,0">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.89">
                            <GradientStop Color="#F0020B2E" Offset="0.99"/>
                            <GradientStop Color="#F02268BF" Offset="0.707"/>
                            <GradientStop Color="#FF020A2B" Offset="0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="/Images/LogoOnly.png"/>
                    <Button Grid.Row="1" Content="🏠  Dashboard"           Command="{Binding NavBar.GoToMainDashboardCommand}" Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="2" Content="📟  Submit Meter Reading" Command="{Binding NavBar.GoToSubmitMeterCommand}"   Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="3" Content="💳  Billing"              Command="{Binding NavBar.GoToBillingCommand}"       Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="4" Content="🔔  Alerts"               Command="{Binding NavBar.GoToAlertsCommand}" Tag="Active" Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="5" Content="🚪  Log Out"              Command="{Binding NavBar.LogoutCommand}"            Style="{StaticResource NavButtonDanger}"/>
                </Grid>
            </Expander>

            <!-- ===== MAIN PANEL ===== -->
            <Border Width="615" CornerRadius="18" Background="#050F2D"
                    BorderBrush="#1E5EFF" BorderThickness="1"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="102,30,0,0" Padding="20,18,20,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#0A84FF" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Title -->
                    <TextBlock Text="🔔  My Alerts" FontSize="18" FontWeight="SemiBold"
                               Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding HouseHold.OwnerName}" FontSize="11"
                               Foreground="#7BA4D4" FontFamily="Segoe UI" Margin="0,0,0,12"/>

                    <!-- Summary row -->
                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,14">
                        <Border Margin="0,0,5,0" CornerRadius="10" Background="#0A1A40"
                                BorderBrush="#1E5EFF" BorderThickness="1" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Pending" FontSize="10" Foreground="#7BA4D4" FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding PendingCount}" FontSize="22"
                                           Foreground="#F0A500" FontFamily="Segoe UI" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="2,0,3,0" CornerRadius="10" Background="#0A1A40"
                                BorderBrush="#1E5EFF" BorderThickness="1" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Acknowledged" FontSize="10" Foreground="#7BA4D4" FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding AcknowledgedCount}" FontSize="22"
                                           Foreground="#3D9BE9" FontFamily="Segoe UI" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="5,0,0,0" CornerRadius="10" Background="#0A1A40"
                                BorderBrush="#1E5EFF" BorderThickness="1" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Resolved" FontSize="10" Foreground="#7BA4D4" FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding ResolvedCount}" FontSize="22"
                                           Foreground="#2ECC71" FontFamily="Segoe UI" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Filter + action buttons row -->
                    <DockPanel Margin="0,0,0,10">
                        <!-- Filters -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="All"          Command="{Binding FilterAllCommand}"          Padding="12,5" Margin="0,0,5,0" FontFamily="Segoe UI" FontSize="11" Foreground="White" Background="#1A3A6B" BorderBrush="#1E5EFF" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Pending"      Command="{Binding FilterPendingCommand}"      Padding="12,5" Margin="0,0,5,0" FontFamily="Segoe UI" FontSize="11" Foreground="White" Background="#1A3A6B" BorderBrush="#F0A500" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Acknowledged" Command="{Binding FilterAcknowledgedCommand}" Padding="12,5" Margin="0,0,5,0" FontFamily="Segoe UI" FontSize="11" Foreground="White" Background="#1A3A6B" BorderBrush="#3D9BE9" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="Resolved"     Command="{Binding FilterResolvedCommand}"     Padding="12,5" FontFamily="Segoe UI" FontSize="11" Foreground="White" Background="#1A3A6B" BorderBrush="#2ECC71" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="✔ Acknowledge" Command="{Binding AcknowledgeCommand}"
                                    Padding="12,5" Margin="0,0,6,0" FontFamily="Segoe UI" FontSize="11"
                                    Foreground="White" Background="#1A3A6B" BorderBrush="#3D9BE9"
                                    BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="✔ Resolve" Command="{Binding ResolveCommand}"
                                    Padding="12,5" FontFamily="Segoe UI" FontSize="11"
                                    Foreground="White" Background="#0D3020" BorderBrush="#2ECC71"
                                    BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Status message -->
                    <TextBlock Text="{Binding Message}" FontSize="11" FontFamily="Segoe UI"
                               Margin="0,0,0,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2ECC71"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                        <Setter Property="Foreground" Value="#E05555"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Alerts DataGrid -->
                    <DataGrid ItemsSource="{Binding FilteredAlerts}"
                              SelectedItem="{Binding SelectedAlert, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Height="250"
                              Background="#050F2D"
                              RowBackground="#050F2D"
                              AlternatingRowBackground="#0A1A40"
                              Foreground="White"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E3060"
                              FontFamily="Segoe UI"
                              FontSize="12"
                              CanUserResizeColumns="False"
                              ColumnHeaderHeight="32"
                              SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0A1A40"/>
                                <Setter Property="Foreground" Value="#7BA4D4"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize"   Value="11"/>
                                <Setter Property="Padding"    Value="8,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Alert ID"   Binding="{Binding AlrtID}"     Width="75"/>
                            <DataGridTextColumn Header="Type"       Binding="{Binding AlertType}"  Width="120"/>
                            <DataGridTextColumn Header="Date"       Binding="{Binding AlertDate}"  Width="110"/>
                            <DataGridTextColumn Header="Message"    Binding="{Binding Message}"    Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontFamily="Segoe UI" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Foreground" Value="#F0A500"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Acknowledged">
                                                            <Setter Property="Foreground" Value="#3D9BE9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </Grid>
    </Viewbox>
</Window>
