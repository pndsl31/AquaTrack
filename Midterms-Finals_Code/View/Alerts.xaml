<Window x:Class="AquaTrack.View.Alerts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AquaTrack.View"
        mc:Ignorable="d"
        Title="Alerts"
        Background="#020B2E"
        Height="620" 
        Width="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Viewbox>
        <Grid Width="800">
            <Grid.Background>
                <ImageBrush ImageSource="../Images/WaterHomepageBG.png"/>
            </Grid.Background>
            <Expander HorizontalAlignment="Left" Height="426" Header="☰  AquaTrack" IsExpanded="False" 
  Margin="4,0,0,0" VerticalAlignment="Center" Width="200" 
  Foreground="White">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontFamily"     Value="Segoe UI"/>
                        <Setter Property="FontSize"       Value="13"/>
                        <Style.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter Property="Width" Value="32"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter Property="Width" Value="200"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>

                <Grid Background="#0A1628" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>



                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="/Images/LogoOnly.png"/>
                    <Button Grid.Row="1" Content="🏠  Dashboard"  Command="{Binding HomePageCommand}" Style="{StaticResource NavButton}" />
                    <Button Grid.Row="2" Content="📟  Submit Meter Reading"  Command="{Binding WorkoutCommand}"    Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="3" Content="💳  Billing"     Command="{Binding ProfileCommand}"    Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="4" Content="🔔  Alerts"      Command="{Binding WorkoutCommand}"    Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="5" Content="🚪  Log Out"  Command="{Binding LogoutCommand}"  Style="{StaticResource NavButtonDanger}"/>
                </Grid>
            </Expander>
            <Border Width="549"
                Height="316"
                CornerRadius="18"
                Background="#050F2D"
                BorderBrush="#1E5EFF"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="158,65,0,0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                        ShadowDepth="0"
                        Color="#0A84FF"
                        Opacity="0.35"/>
                </Border.Effect>
                <Grid Margin="10,10,10,15">
                    <Border 
                        Height="2"
                        VerticalAlignment="Top"
                        CornerRadius="1"
                        Opacity="0.9" 
                        Margin="-5,269,5,0">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1B5FC6" Offset="0"/>
                                <GradientStop Color="#3C7DDB" Offset="0.5"/>
                                <GradientStop Color="#1B5FC6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6"
                                ShadowDepth="0"
                                Color="#3C7DDB"
                                Opacity="0.35"/>
                        </Border.Effect>

                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Window>
