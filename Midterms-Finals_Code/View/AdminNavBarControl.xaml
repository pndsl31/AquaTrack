<UserControl x:Class="AquaTrack.View.AdminNavBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2E4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavBtnDanger" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Foreground" Value="#FF6B6B"/>
        </Style>
    </UserControl.Resources>

    <Expander Header="☰  AquaTrack" IsExpanded="False"
              Foreground="White" VerticalAlignment="Center"
              Height="520" Width="253">
        <Expander.Style>
            <Style TargetType="Expander">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsExpanded" Value="False">
                        <Setter Property="Width" Value="32"/>
                    </Trigger>
                    <Trigger Property="IsExpanded" Value="True">
                        <Setter Property="Width" Value="200"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Expander.Style>

        <Grid Background="#0A1628">
            <Grid.RowDefinitions>
                <RowDefinition Height="130"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="38*"/>
                <RowDefinition Height="38*"/>
            </Grid.RowDefinitions>
            <Image Grid.Row="0" Source="/Images/LogoOnly.png"/>
            <Button Grid.Row="1" Content="🏠  Dashboard"         Command="{Binding GoToDashboardCommand}"  Style="{StaticResource NavBtn}"/>
            <Button Grid.Row="2" Content="👤  Accounts"          Command="{Binding GoToAccountsCommand}"   Style="{StaticResource NavBtn}"/>
            <Button Grid.Row="3" Content="🏘  Households"        Command="{Binding GoToHouseholdsCommand}" Style="{StaticResource NavBtn}"/>
            <Button Grid.Row="4" Content="📊  Meters"            Command="{Binding GoToMetersCommand}"     Style="{StaticResource NavBtn}"/>
            <Button Grid.Row="5" Content="📟  Usage Recording"   Command="{Binding GoToUsageCommand}"      Style="{StaticResource NavBtn}"/>
            <Button Grid.Row="6" Content="💳  Billing"           Command="{Binding GoToBillingCommand}"    Style="{StaticResource NavBtn}"/>
            <Button Grid.Row="7" Content="🔔  Alerts"            Command="{Binding GoToAlertsCommand}"     Style="{StaticResource NavBtn}"/>
            <Button Grid.Row="8" Content="📋  Reports"           Command="{Binding GoToReportsCommand}"    Style="{StaticResource NavBtn}"/>
            <Button Grid.Row="9" Content="🚪  Log Out"           Command="{Binding LogoutCommand}"         Style="{StaticResource NavBtnDanger}"/>
        </Grid>
    </Expander>
</UserControl>