<Window x:Class="AquaTrack.View.Billing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaTrack — Billing"
        Background="#020B2E"
        Height="620" Width="1086"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Viewbox>
        <Grid Width="906">
            <Grid.Background>
                <ImageBrush ImageSource="../Images/WaterHomepageBG.png"/>
            </Grid.Background>

            <!-- ===== NAV BAR ===== -->
            <Expander HorizontalAlignment="Left" Height="499" Header="☰  AquaTrack"
          IsExpanded="False" VerticalAlignment="Center"
          Foreground="White" Panel.ZIndex="10" Width="201">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontFamily"      Value="Segoe UI"/>
                        <Setter Property="FontSize"        Value="13"/>
                        <Style.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter Property="Width" Value="32"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter Property="Width" Value="200"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Grid Margin="0,4,0,0">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.89">
                            <GradientStop Color="#F0020B2E" Offset="0.99"/>
                            <GradientStop Color="#F02268BF" Offset="0.707"/>
                            <GradientStop Color="#FF020A2B" Offset="0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="/Images/LogoOnly.png"/>
                    <Button Grid.Row="1" Content="🏠  Dashboard"           Command="{Binding NavBar.GoToMainDashboardCommand}" Tag="Active" Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="2" Content="📟  Submit Meter Reading" Command="{Binding NavBar.GoToSubmitMeterCommand}"   Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="3" Content="💳  Billing"              Command="{Binding NavBar.GoToBillingCommand}"       Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="4" Content="🔔  Alerts"               Command="{Binding NavBar.GoToAlertsCommand}"        Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="5" Content="🚪  Log Out"              Command="{Binding NavBar.LogoutCommand}"            Style="{StaticResource NavButtonDanger}"/>
                </Grid>
            </Expander>

            <!-- ===== MAIN PANEL ===== -->
            <Border Width="615" CornerRadius="18" Background="#050F2D"
                    BorderBrush="#1E5EFF" BorderThickness="1"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="102,30,0,0" Padding="20,18,20,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#0A84FF" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Title row -->
                    <TextBlock Text="💳  My Billing" FontSize="18" FontWeight="SemiBold"
                               Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding HouseHold.OwnerName}" FontSize="11"
                               Foreground="#7BA4D4" FontFamily="Segoe UI" Margin="0,0,0,12"/>

                    <!-- Summary row -->
                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,14">
                        <Border Margin="0,0,5,0" CornerRadius="10" Background="#0A1A40"
                                BorderBrush="#1E5EFF" BorderThickness="1" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Unpaid Bills" FontSize="10" Foreground="#7BA4D4" FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding UnpaidCount}" FontSize="22" Foreground="#E05555"
                                           FontFamily="Segoe UI" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="2,0,3,0" CornerRadius="10" Background="#0A1A40"
                                BorderBrush="#1E5EFF" BorderThickness="1" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Paid Bills" FontSize="10" Foreground="#7BA4D4" FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding PaidCount}" FontSize="22" Foreground="#2ECC71"
                                           FontFamily="Segoe UI" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="5,0,0,0" CornerRadius="10" Background="#0A1A40"
                                BorderBrush="#1E5EFF" BorderThickness="1" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Total Outstanding" FontSize="10" Foreground="#7BA4D4" FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding TotalUnpaid, StringFormat='PHP {0:F2}'}"
                                           FontSize="14" Foreground="#E05555"
                                           FontFamily="Segoe UI" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Filter buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Right">
                        <Button Content="All" Command="{Binding FilterAllCommand}"
                                Padding="14,5" Margin="0,0,6,0" FontFamily="Segoe UI" FontSize="11"
                                Foreground="White" Background="#1A3A6B" BorderBrush="#1E5EFF"
                                BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Unpaid" Command="{Binding FilterUnpaidCommand}"
                                Padding="14,5" Margin="0,0,6,0" FontFamily="Segoe UI" FontSize="11"
                                Foreground="White" Background="#1A3A6B" BorderBrush="#E05555"
                                BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Paid" Command="{Binding FilterPaidCommand}"
                                Padding="14,5" FontFamily="Segoe UI" FontSize="11"
                                Foreground="White" Background="#1A3A6B" BorderBrush="#2ECC71"
                                BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Bills DataGrid -->
                    <DataGrid ItemsSource="{Binding FilteredBills}"
                              SelectedItem="{Binding SelectedBill, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Height="265"
                              Background="#050F2D"
                              RowBackground="#050F2D"
                              AlternatingRowBackground="#0A1A40"
                              Foreground="White"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E3060"
                              FontFamily="Segoe UI"
                              FontSize="12"
                              CanUserResizeColumns="False"
                              ColumnHeaderHeight="32"
                              SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0A1A40"/>
                                <Setter Property="Foreground" Value="#7BA4D4"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize"   Value="11"/>
                                <Setter Property="Padding"    Value="8,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bill ID"    Binding="{Binding BillID}"    Width="80"/>
                            <DataGridTextColumn Header="Usage ID"   Binding="{Binding UsageID}"   Width="80"/>
                            <DataGridTextColumn Header="Due Date"   Binding="{Binding DueDate}"   Width="110"/>
                            <DataGridTextColumn Header="Amount Due" Binding="{Binding AmountDue, StringFormat='PHP {0:F2}'}" Width="110"/>
                            <DataGridTemplateColumn Header="Status" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontFamily="Segoe UI" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Unpaid">
                                                            <Setter Property="Foreground" Value="#E05555"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </Grid>
    </Viewbox>
</Window>
