<Window x:Class="AquaTrack.View.SubmitReading"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaTrack — Submit Meter Reading"
        Background="#020B2E"
        Height="620" Width="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Viewbox>
        <Grid Width="964">
            <Grid.Background>
                <ImageBrush ImageSource="../Images/WaterHomepageBG.png"/>
            </Grid.Background>

            <!-- ===== NAV BAR ===== -->
            <Expander HorizontalAlignment="Left" Height="528" Header="☰  AquaTrack"
          IsExpanded="False" VerticalAlignment="Top"
          Foreground="White" Panel.ZIndex="10" Width="201">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontFamily"      Value="Segoe UI"/>
                        <Setter Property="FontSize"        Value="13"/>
                        <Style.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter Property="Width" Value="32"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter Property="Width" Value="200"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Grid Margin="0,4,0,0">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.89">
                            <GradientStop Color="#F0020B2E" Offset="0.99"/>
                            <GradientStop Color="#F02268BF" Offset="0.707"/>
                            <GradientStop Color="#FF020A2B" Offset="0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="/Images/LogoOnly.png"/>
                    <Button Grid.Row="1" Content="🏠  Dashboard"           Command="{Binding NavBar.GoToMainDashboardCommand}" Tag="Active" Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="2" Content="📟  Submit Meter Reading" Command="{Binding NavBar.GoToSubmitMeterCommand}"   Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="3" Content="💳  Billing"              Command="{Binding NavBar.GoToBillingCommand}"       Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="4" Content="🔔  Alerts"               Command="{Binding NavBar.GoToAlertsCommand}"        Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="5" Content="🚪  Log Out"              Command="{Binding NavBar.LogoutCommand}"            Style="{StaticResource NavButtonDanger}"/>
                </Grid>
            </Expander>

            <!-- ===== MAIN PANEL ===== -->
            <Border Width="615" CornerRadius="18" Background="#050F2D"
                    BorderBrush="#1E5EFF" BorderThickness="1"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="102,30,0,0" Padding="20,18,20,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#0A84FF" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Title -->
                    <TextBlock Text="📟  Submit Meter Reading" FontSize="18" FontWeight="SemiBold"
                               Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding HouseHold.OwnerName}" FontSize="11"
                               Foreground="#7BA4D4" FontFamily="Segoe UI" Margin="0,0,0,14"/>

                    <!-- Meter info row -->
                    <Border CornerRadius="10" Background="#0A1A40" BorderBrush="#1E5EFF"
                            BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏲  Active Meter: " FontSize="12" Foreground="#7BA4D4"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MeterDisplay}" FontSize="13" Foreground="White"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Input form -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Consumption -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Consumption (m³)" FontSize="11" Foreground="#7BA4D4"
                                       FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <Border CornerRadius="8" BorderBrush="#1E5EFF" BorderThickness="1" Background="#0A1A40">
                                <TextBox Text="{Binding Consumption, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="White"
                                         BorderThickness="0" Padding="10,8"
                                         FontFamily="Segoe UI" FontSize="13"
                                         CaretBrush="White"/>
                            </Border>
                        </StackPanel>

                        <!-- Read Date -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Read Date (YYYY-MM-DD)" FontSize="11" Foreground="#7BA4D4"
                                       FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <Border CornerRadius="8" BorderBrush="#1E5EFF" BorderThickness="1" Background="#0A1A40">
                                <TextBox Text="{Binding ReadDate, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="White"
                                         BorderThickness="0" Padding="10,8"
                                         FontFamily="Segoe UI" FontSize="13"
                                         CaretBrush="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Submit button -->
                    <Button Content="Submit Reading" Command="{Binding SubmitCommand}"
                            HorizontalAlignment="Left" Padding="20,9"
                            FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Background="#1E5EFF" BorderThickness="0"
                            Cursor="Hand" Margin="0,0,0,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Status message -->
                    <TextBlock Text="{Binding Message}" FontSize="11" FontFamily="Segoe UI"
                               Margin="0,0,0,12" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2ECC71"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                        <Setter Property="Foreground" Value="#E05555"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Divider -->
                    <Border Height="1" Background="#1E3060" Margin="0,0,0,12"/>

                    <!-- Recent readings -->
                    <TextBlock Text="Recent Readings" FontSize="12" Foreground="#7BA4D4"
                               FontFamily="Segoe UI" Margin="0,0,0,8"/>

                    <DataGrid ItemsSource="{Binding RecentReadings}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Height="185"
                              Background="#050F2D"
                              RowBackground="#050F2D"
                              AlternatingRowBackground="#0A1A40"
                              Foreground="White"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E3060"
                              FontFamily="Segoe UI"
                              FontSize="12"
                              CanUserResizeColumns="False"
                              ColumnHeaderHeight="30"
                              SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0A1A40"/>
                                <Setter Property="Foreground" Value="#7BA4D4"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize"   Value="11"/>
                                <Setter Property="Padding"    Value="8,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Usage ID"    Binding="{Binding UsageID}"                                       Width="80"/>
                            <DataGridTextColumn Header="Read Date"   Binding="{Binding ReadDate}"                                      Width="110"/>
                            <DataGridTextColumn Header="Consumption" Binding="{Binding Consumption, StringFormat='{}{0:F3} m³'}"       Width="110"/>
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UsageStatus}" FontFamily="Segoe UI" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsageStatus}" Value="Excessive">
                                                            <Setter Property="Foreground" Value="#E05555"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </Grid>
    </Viewbox>
</Window>
