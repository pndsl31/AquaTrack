<Window x:Class="AquaTrack.View.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaTrack — Dashboard"
        Background="#020B2E"
        Height="620" Width="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Viewbox>
        <Grid Width="800">
            <Grid.Background>
                <ImageBrush ImageSource="../Images/WaterHomepageBG.png"/>
            </Grid.Background>

            <!-- ===== NAV BAR ===== -->
            <Expander HorizontalAlignment="Left" Height="426" Header="☰  AquaTrack"
                      IsExpanded="False" VerticalAlignment="Center"
                      Foreground="White" Panel.ZIndex="10" Width="201">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontFamily"      Value="Segoe UI"/>
                        <Setter Property="FontSize"        Value="13"/>
                        <Style.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter Property="Width" Value="32"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter Property="Width" Value="200"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Grid Margin="0,4,0,0">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.89">
                            <GradientStop Color="#F0020B2E" Offset="0.99"/>
                            <GradientStop Color="#F02268BF" Offset="0.707"/>
                            <GradientStop Color="#FF020A2B" Offset="0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="/Images/LogoOnly.png"/>
                    <Button Grid.Row="1" Content="🏠  Dashboard"           Command="{Binding NavBar.GoToMainDashboardCommand}" Tag="Active" Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="2" Content="📟  Submit Meter Reading" Command="{Binding NavBar.GoToSubmitMeterCommand}"   Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="3" Content="💳  Billing"              Command="{Binding NavBar.GoToBillingCommand}"       Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="4" Content="🔔  Alerts"               Command="{Binding NavBar.GoToAlertsCommand}"        Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="5" Content="🚪  Log Out"              Command="{Binding NavBar.LogoutCommand}"            Style="{StaticResource NavButtonDanger}"/>
                </Grid>
            </Expander>

            <!-- ===== HEADER CARD — identity info ===== -->
            <Border Width="615" Height="119" CornerRadius="18"
                    Background="#050F2D" BorderBrush="#1E5EFF" BorderThickness="1"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="102,36,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#0A84FF" Opacity="0.35"/>
                </Border.Effect>
                <Grid Margin="20,10,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Household ID -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🏠" FontSize="22" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Household ID" FontSize="11" Foreground="#7BA4D4"
                                   HorizontalAlignment="Center" FontFamily="Segoe UI" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding HouseHold.HouseholdID}" FontSize="13" Foreground="White"
                                   HorizontalAlignment="Center" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Column="1" Width="1" Background="#1E5EFF" Margin="8,8,8,8" Opacity="0.6"/>

                    <!-- Account Number -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Account Number" FontSize="11" Foreground="#7BA4D4"
                                   HorizontalAlignment="Center" FontFamily="Segoe UI" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding CurrentUser.AccountNumber}" FontSize="13" Foreground="White"
                                   HorizontalAlignment="Center" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Column="3" Width="1" Background="#1E5EFF" Margin="8,8,8,8" Opacity="0.6"/>

                    <!-- Meter Number -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⏲" FontSize="22" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Meter Number" FontSize="11" Foreground="#7BA4D4"
                                   HorizontalAlignment="Center" FontFamily="Segoe UI" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding Meter.MeterNumber}" FontSize="13" Foreground="White"
                                   HorizontalAlignment="Center" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== WELCOME TEXT ===== -->
            <TextBlock Text="{Binding HouseHold.OwnerName}" FontSize="22" FontWeight="SemiBold"
                       Margin="110,165,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Foreground="White" FontFamily="Segoe UI"/>
            <TextBlock Text="Here's your water usage summary." FontSize="12"
                       Margin="110,192,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Foreground="#7BA4D4" FontFamily="Segoe UI"/>

            <!-- ===== SUMMARY CARDS ===== -->
            <UniformGrid Rows="1" Columns="3"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="615" Margin="102,215,0,0">

                <!-- Card 1: Unpaid Bills -->
                <Border Margin="0,0,8,0" CornerRadius="14" Background="#050F2D"
                        BorderBrush="#1E5EFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#0A84FF" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel Margin="16,14,16,14" VerticalAlignment="Center">
                        <TextBlock Text="💳  Unpaid Bills" FontSize="11" Foreground="#7BA4D4"
                                   FontFamily="Segoe UI" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding UnpaidBills}" FontSize="32" Foreground="White"
                                   FontFamily="Segoe UI" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalUnpaid, StringFormat='PHP {0:F2} outstanding'}"
                                   FontSize="10" Foreground="#E05555" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Pending Alerts -->
                <Border Margin="4,0,4,0" CornerRadius="14" Background="#050F2D"
                        BorderBrush="#1E5EFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#0A84FF" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel Margin="16,14,16,14" VerticalAlignment="Center">
                        <TextBlock Text="🔔  Pending Alerts" FontSize="11" Foreground="#7BA4D4"
                                   FontFamily="Segoe UI" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding PendingAlerts}" FontSize="32" Foreground="White"
                                   FontFamily="Segoe UI" FontWeight="Bold"/>
                        <TextBlock Text="Require your attention" FontSize="10"
                                   Foreground="#F0A500" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Last Reading -->
                <Border Margin="8,0,0,0" CornerRadius="14" Background="#050F2D"
                        BorderBrush="#1E5EFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#0A84FF" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel Margin="16,14,16,14" VerticalAlignment="Center">
                        <TextBlock Text="📊  Last Reading" FontSize="11" Foreground="#7BA4D4"
                                   FontFamily="Segoe UI" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding LastConsumption, StringFormat='{}{0:F3} m³'}"
                                   FontSize="22" Foreground="White" FontFamily="Segoe UI" FontWeight="Bold"/>
                        <TextBlock Text="{Binding LastReadDate}" FontSize="10"
                                   Foreground="#A8C8E8" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding LastUsageStatus}" FontSize="10" FontFamily="Segoe UI"
                                   Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastUsageStatus}" Value="Excessive">
                                            <Setter Property="Foreground" Value="#E05555"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== QUICK ACTIONS ===== -->
            <Border Width="615" Height="80" CornerRadius="14"
                    Background="#050F2D" BorderBrush="#1E5EFF" BorderThickness="1"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="102,360,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#0A84FF" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,20,0">
                    <TextBlock Text="Quick Actions:" FontSize="12" Foreground="#7BA4D4"
                               FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="📟  Submit Reading" Command="{Binding NavBar.GoToSubmitMeterCommand}"
                            Foreground="White" Background="#1A3A6B" BorderBrush="#1E5EFF"
                            BorderThickness="1" Padding="14,6" Margin="0,0,10,0"
                            FontFamily="Segoe UI" FontSize="12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="💳  View Bills" Command="{Binding NavBar.GoToBillingCommand}"
                            Foreground="White" Background="#1A3A6B" BorderBrush="#1E5EFF"
                            BorderThickness="1" Padding="14,6" Margin="0,0,10,0"
                            FontFamily="Segoe UI" FontSize="12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="🔔  View Alerts" Command="{Binding NavBar.GoToAlertsCommand}"
                            Foreground="White" Background="#1A3A6B" BorderBrush="#1E5EFF"
                            BorderThickness="1" Padding="14,6"
                            FontFamily="Segoe UI" FontSize="12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Viewbox>
</Window>