<Window x:Class="AquaTrack.View.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AquaTrack — Dashboard"
        Background="#020B2E"
        Height="620" Width="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Viewbox>
        <Grid Width="800">
            <Grid.Background>
                <ImageBrush ImageSource="../Images/WaterHomepageBG.png"/>
            </Grid.Background>
            <Grid HorizontalAlignment="Left" 
                  Height="147" 
                  Margin="135,117,0,0" 
                  VerticalAlignment="Top" 
                  Width="280"/>
            <Grid HorizontalAlignment="Left" 
                  Height="147" 
                  Margin="437,117,0,0" 
                  VerticalAlignment="Top" 
                  Width="280"/>
            <Border 
                Width="615"
                Height="119"
                CornerRadius="18"
                Background="#050F2D"
                BorderBrush="#1E5EFF"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" 
                Margin="102,36,0,0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                          ShadowDepth="0"
                          Color="#0A84FF"
                          Opacity="0.35"/>
                </Border.Effect>
                <Grid Margin="9,9,10,15">
                    <Border
                        CornerRadius="1"
                        Opacity="0.9" Margin="141,71,414,19" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="-89.701"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Border.RenderTransform>

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1B5FC6" Offset="0"/>
                                <GradientStop Color="#3C7DDB" Offset="0.5"/>
                                <GradientStop Color="#1B5FC6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6"
                  ShadowDepth="0"
                  Color="#3C7DDB"
                  Opacity="0.35"/>
                        </Border.Effect>

                    </Border>
                    <Border
                        CornerRadius="1"
                        Opacity="0.9" Margin="334,71,221,19" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="-89.701"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Border.RenderTransform>

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1B5FC6" Offset="0"/>
                                <GradientStop Color="#3C7DDB" Offset="0.5"/>
                                <GradientStop Color="#1B5FC6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6"
                                ShadowDepth="0"
                                Color="#3C7DDB"
                                Opacity="0.35"/>
                        </Border.Effect>

                    </Border>
                </Grid>

            </Border>


            <Border Width="194"
                Height="76"
                CornerRadius="18"
                Background="#050F2D"
                BorderBrush="#1E5EFF"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="102,360,0,0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                        ShadowDepth="0"
                        Color="#0A84FF"
                        Opacity="0.35"/>
                </Border.Effect>

            </Border>
            <Border Width="194"
                Height="76"
                CornerRadius="18"
                Background="#050F2D"
                BorderBrush="#1E5EFF"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="313,360,0,0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                        ShadowDepth="0"
                        Color="#0A84FF"
                        Opacity="0.35"/>
                </Border.Effect>

            </Border>
            <Border Width="194"
                Height="76"
                CornerRadius="18"
                Background="#050F2D"
                BorderBrush="#1E5EFF"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="523,360,0,0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                        ShadowDepth="0"
                        Color="#0A84FF"
                        Opacity="0.35"/>
                </Border.Effect>

            </Border>
            <Border Width="192"
                Height="186"
                CornerRadius="18"
                Background="#050F2D"
                BorderBrush="#1E5EFF"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="104,165,0,0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                        ShadowDepth="0"
                        Color="#0A84FF"
                        Opacity="0.35"/>
                </Border.Effect>

                <Grid Margin="10,10,10,15">
                    <Border Height="2"
            VerticalAlignment="Top"
            CornerRadius="1"
            Opacity="0.9" Margin="0,55,0,0">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1B5FC6" Offset="0"/>
                                <GradientStop Color="#3C7DDB" Offset="0.5"/>
                                <GradientStop Color="#1B5FC6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6"
                              ShadowDepth="0"
                              Color="#3C7DDB"
                              Opacity="0.35"/>
                        </Border.Effect>

                    </Border>
                </Grid>

            </Border>
            <Border Width="194"
                Height="186"
                CornerRadius="18"
                Background="#050F2D"
                BorderBrush="#1E5EFF"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="313,165,0,0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                        ShadowDepth="0"
                        Color="#0A84FF"
                        Opacity="0.35"/>
                </Border.Effect>
                <Grid Margin="10,10,10,15">
                    <Border 
                        Height="2"
                        VerticalAlignment="Top"
                        CornerRadius="1"
                        Opacity="0.9" 
                        Margin="0,55,0,0">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1B5FC6" Offset="0"/>
                                <GradientStop Color="#3C7DDB" Offset="0.5"/>
                                <GradientStop Color="#1B5FC6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6"
                  ShadowDepth="0"
                  Color="#3C7DDB"
                  Opacity="0.35"/>
                        </Border.Effect>

                    </Border>
                </Grid>
            </Border>
            <Border Width="194"
                Height="186"
                CornerRadius="18"
                Background="#050F2D"
                BorderBrush="#1E5EFF"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" Margin="523,165,0,0" RenderTransformOrigin="0.5,0.5">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                        ShadowDepth="0"
                        Color="#0A84FF"
                        Opacity="0.35"/>
                </Border.Effect>
                <Grid Margin="10,10,10,15">
                    <Border 
                        Height="2"
                        VerticalAlignment="Top"
                        CornerRadius="1"
                        Opacity="0.9" 
                        Margin="0,55,0,0">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1B5FC6" Offset="0"/>
                                <GradientStop Color="#3C7DDB" Offset="0.5"/>
                                <GradientStop Color="#1B5FC6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6"
                  ShadowDepth="0"
                  Color="#3C7DDB"
                  Opacity="0.35"/>
                        </Border.Effect>

                    </Border>
                </Grid>
            </Border>
            <Expander HorizontalAlignment="Left" Height="426" Header="☰  AquaTrack" IsExpanded="False" 
  Margin="4,0,0,0" VerticalAlignment="Center" Width="200" 
  Foreground="White">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontFamily"     Value="Segoe UI"/>
                        <Setter Property="FontSize"       Value="13"/>
                        <Style.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter Property="Width" Value="32"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter Property="Width" Value="200"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>

                <Grid Background="#0A1628" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="40*"/>



                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="/Images/LogoOnly.png"/>
                    <Button Grid.Row="1" Content="🏠  Dashboard"  Command="{Binding HomePageCommand}" Style="{StaticResource NavButton}" />
                    <Button Grid.Row="2" Content="📟  Submit Meter Reading"  Command="{Binding NavBar.SubmitMeterCommand}"    Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="3" Content="💳  Billing"     Command="{Binding ProfileCommand}"    Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="4" Content="🔔  Alerts"      Command="{Binding WorkoutCommand}"    Style="{StaticResource NavButton}"/>
                    <Button Grid.Row="5" Content="🚪  Log Out"  Command="{Binding LogoutCommand}"  Style="{StaticResource NavButtonDanger}"/>
                </Grid>
            </Expander>
            <TextBlock Text="{Binding HouseHold.OwnerName}" FontSize="30" Margin="117,48,223,341" Foreground="White" FontFamily="Segoe UI"/>
            
            <TextBlock Text="🏠︎" FontSize="30" Margin="117,95,642,294" Foreground="White"/>
            <TextBlock Text="Household ID" FontSize="15" Margin="166,98,535,314" Foreground="White" FontFamily="Segoe UI"/>
            <TextBlock Text="{Binding HouseHold.HouseholdID}" FontSize="12" Margin="166,120,535,292" Foreground="White" FontFamily="Segoe UI"/>

            <TextBlock Text="👤" FontSize="30" Margin="287,95,472,294" Foreground="White"/>
            <TextBlock Text="Account Number" FontSize="15" Margin="331,98,353,314" Foreground="White" FontFamily="Segoe UI"/>
            <TextBlock Text="{Binding CurrentUser.AccountNumber}" FontSize="12" Margin="332,120,369,292" Foreground="White" FontFamily="Segoe UI"/>
        </Grid>
    </Viewbox>
</Window>