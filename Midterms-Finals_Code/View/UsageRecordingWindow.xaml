<Window x:Class="AquaTrack.View.UsageRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AquaTrack.View"
        Title="AquaTrack — Usage Recording"
        Height="620" Width="1080"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowBackground" Value="#060F25"/>
            <Setter Property="AlternatingRowBackground" Value="#0A1628"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0D1F3C"/>
                        <Setter Property="Foreground" Value="#7DD3FC"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Inp" TargetType="Border">
            <Setter Property="Background" Value="#06172B"/>
            <Setter Property="BorderBrush" Value="#1E3A5F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="../Images/WaterHomepageBG.png"/>
    </Window.Background>
    <Grid>
        <local:AdminNavBarControl DataContext="{Binding NavBar}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="217,19,0,0" Width="640">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Form -->
            <Border Grid.Row="0" Background="#050F2D" BorderBrush="#1E5EFF"
                        BorderThickness="1" CornerRadius="14" Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#0A84FF" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="📟 Record Meter Reading" FontFamily="Segoe UI" FontSize="14"
                                   FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="HOUSEHOLD" FontSize="9" Foreground="#4A7FA5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <Border Style="{StaticResource Inp}">
                                <ComboBox ItemsSource="{Binding Households}"
                                              SelectedItem="{Binding SelectedHousehold}"
                                              DisplayMemberPath="HouseholdID"
                                              Background="Transparent" Foreground="White" BorderThickness="0"
                                              FontFamily="Segoe UI" Height="38"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="3,0">
                            <TextBlock Text="METER (AUTO)" FontSize="9" Foreground="#4A7FA5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <Border Style="{StaticResource Inp}">
                                <TextBlock Text="{Binding MeterDisplay}" Foreground="#7DD3FC"
                                               FontFamily="Segoe UI" Height="38" Padding="10,0"
                                               VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="3,0">
                            <TextBlock Text="CONSUMPTION (m³)" FontSize="9" Foreground="#4A7FA5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <Border Style="{StaticResource Inp}">
                                <TextBox Text="{Binding Consumption, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" Foreground="White" BorderThickness="0"
                                             FontFamily="Segoe UI" Height="38" Padding="10,0" VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="8,0,0,0">
                            <Button Content="Record" Command="{Binding RecordCommand}"
                                        Width="80" Height="38" Cursor="Hand" Foreground="White">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="8" Background="#0EA5E9">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Message}" FontFamily="Segoe UI" FontSize="11" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#F87171"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="#4ADE80"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Recent readings -->
            <Border Grid.Row="2" Background="#050F2D" BorderBrush="#1E5EFF"
                        BorderThickness="1" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#0A84FF" Opacity="0.3"/>
                </Border.Effect>
                <DataGrid ItemsSource="{Binding RecentUsage}" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Usage ID"    Binding="{Binding UsageID}"     Width="80"/>
                        <DataGridTextColumn Header="Household"   Binding="{Binding OwnerName}"   Width="140"/>
                        <DataGridTextColumn Header="Read Date"   Binding="{Binding ReadDate}"    Width="110"/>
                        <DataGridTextColumn Header="m³"          Binding="{Binding Consumption}" Width="70"/>
                        <DataGridTemplateColumn Header="Status"  Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UsageStatus}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#4ADE80"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UsageStatus}" Value="Excessive">
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>

</Window>