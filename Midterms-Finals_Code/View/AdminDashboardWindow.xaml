<Window x:Class="AquaTrack.View.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AquaTrack.View"
        Title="AquaTrack — Admin Dashboard"
        Height="620" Width="1080"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="../Images/WaterHomepageBG.png"/>
        </Grid.Background>

        <local:AdminNavBarControl DataContext="{Binding NavBar}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"/>

        <!-- Welcome -->
        <Border Width="620" Height="75"
                    Background="#050F2D" BorderBrush="#1E5EFF" BorderThickness="1"
                    CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="238,24,0,0" Padding="20,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#0A84FF" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" Foreground="White">
                        <Run Text="Welcome, Admin "/>
                        <Run Text="{Binding CurrentUser.AccountNumber}" Foreground="#7DD3FC"/>
                </TextBlock>
                <TextBlock Text="AquaTrack Administration Panel"
                               FontFamily="Segoe UI" FontSize="11" Foreground="#4A7FA5"/>
            </StackPanel>
        </Border>

        <!-- Stat Cards -->
        <UniformGrid Columns="4" Width="620" Height="120"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="238,111,0,0">
            <!-- Households -->
            <Border Margin="0,0,8,0" Background="#050F2D" BorderBrush="#1E5EFF"
                        BorderThickness="1" CornerRadius="14" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#0A84FF" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🏘" FontSize="22" Foreground="#FFC5E0FF"/>
                    <TextBlock Text="{Binding TotalHouseholds}" FontFamily="Segoe UI"
                                   FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Households" FontFamily="Segoe UI"
                                   FontSize="10" Foreground="#4A7FA5"/>
                </StackPanel>
            </Border>
            <!-- Meters -->
            <Border Margin="4,0,4,0" Background="#050F2D" BorderBrush="#1E5EFF"
                        BorderThickness="1" CornerRadius="14" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#0A84FF" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="22" Foreground="#FFC5E0FF"/>
                    <TextBlock Text="{Binding TotalMeters}" FontFamily="Segoe UI"
                                   FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Meters" FontFamily="Segoe UI"
                                   FontSize="10" Foreground="#4A7FA5"/>
                </StackPanel>
            </Border>
            <!-- Unpaid Bills -->
            <Border Margin="4,0,4,0" Background="#050F2D" BorderBrush="#1E5EFF"
                        BorderThickness="1" CornerRadius="14" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#0A84FF" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="💳" FontSize="22" Foreground="#FFC5E0FF"/>
                    <TextBlock Text="{Binding UnpaidBills}" FontFamily="Segoe UI"
                                   FontSize="28" FontWeight="Bold" Foreground="#FB923C"/>
                    <TextBlock Text="Unpaid Bills" FontFamily="Segoe UI"
                                   FontSize="10" Foreground="#4A7FA5"/>
                </StackPanel>
            </Border>
            <!-- Pending Alerts -->
            <Border Margin="8,0,0,0" Background="#050F2D" BorderBrush="#1E5EFF"
                        BorderThickness="1" CornerRadius="14" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#0A84FF" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🔔" FontSize="22" Foreground="#FFC5E0FF"/>
                    <TextBlock Text="{Binding PendingAlerts}" FontFamily="Segoe UI"
                                   FontSize="28" FontWeight="Bold" Foreground="#F87171"/>
                    <TextBlock Text="Pending Alerts" FontFamily="Segoe UI"
                                   FontSize="10" Foreground="#4A7FA5"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Quick Actions -->
        <Border Width="620" Height="55"
                    Background="#050F2D" BorderBrush="#1E5EFF" BorderThickness="1"
                    CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="238,244,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#0A84FF" Opacity="0.25"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="➕ Add Account"    Command="{Binding NavBar.GoToAccountsCommand}"   Width="130" Height="34" Margin="5,0" Cursor="Hand" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="8" Background="#0EA5E9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="🏘 Add Household"  Command="{Binding NavBar.GoToHouseholdsCommand}" Width="130" Height="34" Margin="5,0" Cursor="Hand" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="8" BorderBrush="#1E5EFF" BorderThickness="1" Background="#0A1628">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#1E3A5F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="📟 Record Usage"   Command="{Binding NavBar.GoToUsageCommand}"      Width="130" Height="34" Margin="5,0" Cursor="Hand" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="8" BorderBrush="#1E5EFF" BorderThickness="1" Background="#0A1628">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#1E3A5F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="🔔 View Alerts"    Command="{Binding NavBar.GoToAlertsCommand}"     Width="130" Height="34" Margin="5,0" Cursor="Hand" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="8" BorderBrush="#1E5EFF" BorderThickness="1" Background="#0A1628">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#1E3A5F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- Recent Activity placeholder -->
        <Border Width="620" Height="240"
                    Background="#050F2D" BorderBrush="#1E5EFF" BorderThickness="1"
                    CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="238,311,0,0" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#0A84FF" Opacity="0.25"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="System Overview" FontFamily="Segoe UI" FontSize="14"
                               FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#4A7FA5" TextWrapping="Wrap">
                        <Run Text="• Use the navigation panel on the left to manage accounts, households, meters, and more."/>
                </TextBlock>
                <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#4A7FA5" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="• Record usage readings on behalf of any household under Usage Recording."/>
                </TextBlock>
                <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#4A7FA5" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="• Mark bills as Paid and resolve alerts from the Billing and Alerts screens."/>
                </TextBlock>
                <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#4A7FA5" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="• View per-household consumption and billing history under Reports."/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>